  "signing_message_vectors": [
    {
      "name": "single_signer_signing_message",
      "description": "Signing message for single-signer transaction",
      "formula": "SHA3-256('APTOS::RawTransaction') || BCS(RawTransaction)",
      "domain_prefix_hex": "b5e97db07fa0bd0e5598aa3643a9bc6f6693bddc1a9fec9e674a461eaa00b193",
      "note": "Domain prefix is 32 bytes, followed by BCS-serialized transaction"
    },
    {
      "name": "multi_agent_signing_message",
      "description": "Signing message for multi-agent transaction",
      "formula": "SHA3-256('APTOS::RawTransactionWithData') || BCS(RawTransactionWithData::MultiAgent)",
      "domain_prefix_hex": "5efa3c4f02f83a0f4b2d69fc95c607cc02825cc4e7be536ef0992df050d9e67c",
      "note": "RawTransactionWithData includes secondary_signer_addresses"
    },
    {
      "name": "fee_payer_signing_message",
      "description": "Signing message for fee payer transaction",
      "formula": "SHA3-256('APTOS::RawTransactionWithData') || BCS(RawTransactionWithData::FeePayer)",
      "domain_prefix_hex": "5efa3c4f02f83a0f4b2d69fc95c607cc02825cc4e7be536ef0992df050d9e67c",
      "note": "RawTransactionWithData includes secondary_signer_addresses and fee_payer_address"
    }
  ],
  "transaction_hash_vectors": [
    {
      "name": "transaction_hash_formula",
      "description": "How to compute transaction hash",
      "formula": "SHA3-256(SHA3-256('APTOS::Transaction') || BCS(SignedTransaction))",
      "domain_prefix_hex": "fa210a9417ef3e7fa45bfa1d17a8dbd4d883711910a550d265fee189e9266dd4",
      "note": "Double SHA3-256 with domain separator"
    }
  ],
  "authenticator_variants": {
    "ed25519": {
      "variant_index": 0,
      "structure": ["public_key (32 bytes)", "signature (64 bytes)"]
    },
    "multi_ed25519": {
      "variant_index": 1,
      "structure": ["public_keys", "threshold", "signatures with bitmap"]
    },
    "multi_agent": {
      "variant_index": 2,
      "structure": ["sender", "secondary_signer_addresses", "secondary_signers"]
    },
    "fee_payer": {
      "variant_index": 3,
      "structure": ["sender", "secondary_signer_addresses", "secondary_signers", "fee_payer_address", "fee_payer_signer"]
    },
    "single_sender": {
      "variant_index": 4,
      "structure": ["AccountAuthenticator"]
    }
  }
}
