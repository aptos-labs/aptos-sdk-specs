<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Aptos.Specs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK under test (currently in beta) -->
    <PackageReference Include="Aptos" Version="0.0.*-*" />
    
    <!-- BDD Framework -->
    <PackageReference Include="Reqnroll" Version="2.*" />
    <PackageReference Include="Reqnroll.NUnit" Version="2.*" />
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="2.*" />
    
    <!-- Test Runner -->
    <PackageReference Include="NUnit" Version="4.*" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    
    <!-- Assertions -->
    <PackageReference Include="FluentAssertions" Version="7.*" />
    
    <!-- Crypto utilities (SHA3) -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.*" />
  </ItemGroup>

  <!-- Feature files from local symlinked directory -->
  <ItemGroup>
    <None Include="Features\**\*.feature" />
  </ItemGroup>

</Project>
