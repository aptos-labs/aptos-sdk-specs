{
  "name": "aptos-sdk-specs",
  "version": "1.0.0",
  "description": "Behavioral specifications for Aptos SDKs",
  "type": "module",
  "scripts": {
    "format": "prettier --write '**/*.md' '**/*.feature'",
    "format:check": "prettier --check '**/*.md' '**/*.feature'",
    "format:md": "prettier --write '**/*.md'",
    "format:gherkin": "prettier --write '**/*.feature'",
    "format:docs": "prettier --write '*.md' 'categories/*.md' 'test-vectors/*.md' 'tests/*.md'"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "prettier-plugin-gherkin": "^3.1.3"
  },
  "prettier": {
    "proseWrap": "always",
    "printWidth": 100,
    "tabWidth": 2,
    "plugins": ["prettier-plugin-gherkin"]
  }
}
